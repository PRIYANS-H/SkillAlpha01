PROJECT_NAME="SkillAlpha API"
VERSION="1.0.0"
API_V1_STR="/api"

# Security
JWT_SECRET="skillalpha_super_secret_jwt_key_production_2026_change_me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (Default SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./skillalpha.db"
# DATABASE_URL="postgresql://skillalpha_user:skillalpha_password@localhost:5432/skillalpha"

# YouTube Data API v3 (for dynamic video curation and playable video cards)
YOUTUBE_DATA_API_KEY=""

# Optional LLM Enhancement API Key (Groq)
GROQ_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"
